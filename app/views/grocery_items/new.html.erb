<h1>New Grocery Item</h1>

<%= form_with model: @grocery_item, local: true do |form| %>
  <div>
    <%= form.label :name %><br>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :price %><br>
    <%= form.number_field :price, step: 0.01 %>
  </div>

  <div>
    <%= form.label :description %><br>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :is_available, "Available?" %><br>
    <%= form.check_box :is_available %>
  </div>

  <div>
    <%= form.submit "Create Grocery Item" %>
  </div>
<% end %>

<% if flash[:notice] %>
  <p style="color: green;"><%= flash[:notice] %></p>
<% end %>
